# Byte API
BYTE_API_SERVICE_NAME=byte-api
BYTE_API_PREFIX=/api/v1
BYTE_API_KEY=change-me
BYTE_API_KEY_HEADER=X-Byte-Api-Key
BYTE_API_INITIALIZE_ON_STARTUP=1
BYTE_API_STARTUP_STRICT=0
BYTE_API_EXPOSE_ERROR_DETAILS=0
BYTE_API_MAX_FILE_BYTES=262144000
BYTE_API_MAX_CONCURRENT_UPLOADS=4

# PostgreSQL Database A
PG_HOST=127.0.0.1
PG_PORT=5433
SOURCE_PG_DB=assessment_gestio_tier
PG_USER=admin
PG_PASS=admin_password
