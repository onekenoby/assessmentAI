FROM python:3.11.9-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

ENV TOKENIZERS_PARALLELISM=false
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
ENV OPENBLAS_NUM_THREADS=4
ENV NUMEXPR_NUM_THREADS=4

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    unzip \
    libpq5 \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.ingestion.txt /app/requirements.ingestion.txt
COPY requirements.extra.gui.txt /app/requirements.extra.gui.txt
COPY requirements.extra.main.txt /app/requirements.extra.main.txt

RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /app/requirements.ingestion.txt \
    && pip install --no-cache-dir -r /app/requirements.extra.main.txt \
    && pip install --no-cache-dir -r /app/requirements.extra.gui.txt \
    && rm -rf /tmp/pip-* /root/.cache/pip

COPY gui_reflex /app/gui_reflex

WORKDIR /app/gui_reflex

CMD ["reflex", "run", "--env", "prod", "--frontend-host", "0.0.0.0", "--backend-host", "0.0.0.0"]