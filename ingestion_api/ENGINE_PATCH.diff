+    except Exception:
+        pass
+
+    failed = sum(1 for item in results if item.get("status") == "FAILED")
+    done = sum(1 for item in results if item.get("status") == "DONE")
+    status = "DONE" if failed == 0 else ("PARTIAL_FAILED" if done else "FAILED")
+
+    return {
+        "status": status,
+        "jobs_claimed": len(results),
+        "jobs_completed": done,
+        "jobs_failed": failed,
+        "queue_empty": len(results) < max_jobs,
+        "processing_time_ms": _ms(started),
+        "jobs": results,
+    }
