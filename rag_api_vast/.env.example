# -----------------------------------------------------------------------------
# RAG API locale
# -----------------------------------------------------------------------------
POC_MODE=1
POC_ORGANIZATION_ID=1234
RAG_USER_ID=service-user
RAG_USER_ROLES=user,auditor
RAG_ALLOWED_SCOPES=GLOBAL,ACCOUNT
RAG_DEFAULT_TIERS=A,B,C
CORPUS_VERSION=v1

# -----------------------------------------------------------------------------
# PostgreSQL, Qdrant e Neo4j locali: stessi endpoint dell'ingestion
# -----------------------------------------------------------------------------
PG_ENRICH_ENABLED=1
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=assessment_ingestion
PG_USER=admin
PG_PASS=admin_password
PG_MIN_CONN=1
PG_MAX_CONN=8

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6334
QDRANT_COLLECTION=assessment_docs

NEO4J_ENABLED=1
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASS=admin_password

# -----------------------------------------------------------------------------
# Modelli locali Windows
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=E:/Modelli/bge-m3
RERANKER_MODEL_NAME=E:/Modelli/ms-marco-reranker
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu
EMBED_CPU_THREADS=4

# -----------------------------------------------------------------------------
# Ollama remoto Vast.ai tramite tunnel SSH locale
# 127.0.0.1:11435 -> Vast.ai 127.0.0.1:11434
# Non aggiungere /api.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11435
LLM_MODEL_NAME=gemma4:12b
EVAL_MODEL_NAME=gemma4:12b
OLLAMA_API_KEY=ollama
OLLAMA_CONNECT_TIMEOUT_S=30
OLLAMA_WARMUP_ON_STARTUP=1
OLLAMA_WARMUP_TIMEOUT_S=600
OLLAMA_REQUEST_KEEP_ALIVE=30m

LLM_TIMEOUT_S=600
LLM_MAX_ATTEMPTS=2
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=4096
LLM_TEMPERATURE=0.15
LLM_REPEAT_PENALTY=1.15

# Override opzionali. Normalmente vengono derivati da OLLAMA_BASE_URL.
# OLLAMA_URL=http://127.0.0.1:11435/v1
# OLLAMA_NATIVE_CHAT_URL=http://127.0.0.1:11435/api/chat

# -----------------------------------------------------------------------------
# Concorrenza
# -----------------------------------------------------------------------------
RAG_MAX_CONCURRENT_QUERIES=1
RAG_MAX_QUEUED_QUERIES=4
RAG_QUERY_QUEUE_TIMEOUT_S=30
