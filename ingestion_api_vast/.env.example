# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
INGESTION_API_KEY=change-me
INGESTION_API_KEY_HEADER=X-Ingestion-Api-Key
INGESTION_INITIALIZE_ON_STARTUP=1
INGESTION_STARTUP_STRICT=0
INGESTION_DEFAULT_MAX_JOBS=1
INGESTION_MAX_JOBS_PER_RUN=100
INGESTION_RUN_HISTORY_LIMIT=200
INGESTION_EXPOSE_ERROR_DETAILS=0

# Lock PostgreSQL globale: identico su tutte le istanze della stessa pipeline.
INGESTION_GLOBAL_LOCK_KEY=731904271

# -----------------------------------------------------------------------------
# Database B: output RAG
# -----------------------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=assessment_ingestion
PG_USER=admin
PG_PASS=admin_password
PG_MIN_CONN=1
PG_MAX_CONN=8

# -----------------------------------------------------------------------------
# Database A: file BYTEA + schema rag_ingestion
# -----------------------------------------------------------------------------
SOURCE_PG_HOST=127.0.0.1
SOURCE_PG_PORT=5433
SOURCE_PG_DB=assessment_gestio_tier
SOURCE_PG_USER=admin
SOURCE_PG_PASS=admin_password
SOURCE_PG_MIN_CONN=1
SOURCE_PG_MAX_CONN=4
INGESTION_WORKER_ID=worker-ingestion-api-01
JOB_HEARTBEAT_SECONDS=60
JOB_RETRY_DELAY=15 minutes

# -----------------------------------------------------------------------------
# Qdrant / Neo4j
# -----------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6334
QDRANT_COLLECTION=assessment_docs
QDRANT_TIMEOUT_S=120

NEO4J_ENABLED=1
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASS=admin_password

# -----------------------------------------------------------------------------
# Ollama
# In un servizio API è consigliato NON riavviare Ollama dal processo web.
# -----------------------------------------------------------------------------
# URL pubblico Vast.ai oppure endpoint di un tunnel SSH.
# Non aggiungere /api.
OLLAMA_BASE_URL=http://<VAST_PUBLIC_IP>:<VAST_EXTERNAL_PORT>

USE_REMOTE_OLLAMA=1
OLLAMA_AUTOSTART=0

LLM_MODEL_NAME=llama3.1:8b
VISION_MODEL_NAME=ministral-3:8b

OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2

OLLAMA_TIMEOUT_S=240
OLLAMA_VISION_TIMEOUT_S=240
OLLAMA_KG_TIMEOUT_S=180
OLLAMA_RETRIES=1

# Default originale preservato; sovrascrivere in container/Linux.
EMBEDDING_MODEL_NAME=E:/Modelli/bge-m3

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
POC_MODE=1
CORPUS_VERSION=v1
DEFAULT_CLASSIFICATION=internal
PDF_VISION_ENABLED=1
KG_ENABLED=1
EMBED_BATCH_SIZE=16
DB_FLUSH_SIZE=96
VISION_PARALLEL_WORKERS=1
MAX_KG_CHUNKS_PER_DOC=10
PG_COMMIT_EVERY_N_PAGES=25


# Orchestrazione documenti
# 1 = producer prepara il documento successivo mentre il consumer
# elabora AI/PostgreSQL/Qdrant/Neo4j sul precedente.
USE_PRODUCER_CONSUMER=1

# Numero massimo di documenti preparati in attesa del consumer.
# Conservare 1 su GPU singola e memoria limitata.
DOC_QUEUE_MAXSIZE=1